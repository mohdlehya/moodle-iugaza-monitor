# ══════════════════════════════════════════════════════════════
# Environment Variables Template
# ══════════════════════════════════════════════════════════════

# 1. Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. Fernet Credential Encryption Key (generate via: python crypto.py --generate-key)
CREDENTIALS_ENCRYPTION_KEY=s-I-0DmUMvgIJ1lLCX_QQBz2pkPSKMFOvrJRMKAhEn8=

# 3. Database Connection String (PostgreSQL for Render/Production or SQLite for local dev)
# Local SQLite default: sqlite:///./moodle.db
# Managed Postgres: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=postgresql://moodle_user:moodle_secure_password@localhost:5432/moodle_db

# 4. Administrator Telegram Chat ID (for /admin commands)
ADMIN_CHAT_ID=123456789

# 5. Shared Fallback Groq API Key (from console.groq.com)
GROQ_API_KEY=gsk_your_shared_fallback_key_here

# 6. Moodle System Base URL
MOODLE_URL=https://moodle.iugaza.edu.ps

# 7. Web Server Port
PORT=10000
